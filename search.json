---
layout: null
permalink: /search.json
sitemap: false
---
[
{% for d in site.diseases %}
  {%- assign fld = site.data.fields | where: "slug", d.field | first -%}
  {%- capture facts -%}
    {%- for f in d.quick_facts -%}{{ f.label }} {{ f.value }} {% endfor -%}
  {%- endcapture -%}
  {
    "title": {{ d.title | jsonify }},
    "url": {{ d.url | relative_url | jsonify }},
    "field": {{ fld.name | default: d.field | jsonify }},
    "fieldSlug": {{ d.field | jsonify }},
    "synonyms": {{ d.synonyms | default: "" | jsonify }},
    "tags": {{ d.tags | default: "" | jsonify }},
    "summary": {{ d.summary | default: "" | jsonify }},
    "facts": {{ facts | normalize_whitespace | jsonify }},
    "body": {{ d.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
